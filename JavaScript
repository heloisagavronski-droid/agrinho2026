document.addEventListener('DOMContentLoaded', () => {

    // 1. CALCULADORA SUSTENTÁVEL
    const btnCalcular = document.getElementById('btnCalcular');
    const inputLitros = document.getElementById('litrosAgua');
    const resultadoCalculo = document.getElementById('resultadoCalculo');

    if (btnCalcular) {
        btnCalcular.addEventListener('click', () => {
            const litrosDiarios = Number(inputLitros.value);

            if (!litrosDiarios || litrosDiarios <= 0) {
                mostrarMensagem(resultadoCalculo, 'Por favor, digite um número maior que 0!', 'erro');
                return;
            }

            const mensal = (litrosDiarios * 30).toLocaleString('pt-BR');
            const anual = (litrosDiarios * 365).toLocaleString('pt-BR');

            mostrarMensagem(
                resultadoCalculo, 
                `Com ${litrosDiarios}L por dia, você economiza aproximadamente <strong>${mensal} litros/mês</strong> e <strong>${anual} litros/ano</strong>! 💧`, 
                'sucesso'
            );
        });
    }

    // 2. QUIZ SUSTENTÁVEL
    const botoesQuiz = document.querySelectorAll('.btn-quiz');
    const resultadoQuiz = document.getElementById('resultadoQuiz');

    botoesQuiz.forEach(botao => {
        botao.addEventListener('click', (evento) => {
            const botaoClicado = evento.currentTarget;
            const eCorreta = botaoClicado.getAttribute('data-correta') === 'true';

            // Desativa todos os botões após a escolha
            botoesQuiz.forEach(b => {
                b.disabled = true;
                if (b.getAttribute('data-correta') === 'true') {
                    b.classList.add('correta');
                }
            });

            if (eCorreta) {
                mostrarMensagem(resultadoQuiz, 'Resposta Correta! Os Drones Agrícolas ajudam a monitorar as lavouras. 🛸🌱', 'sucesso');
            } else {
                botaoClicado.classList.add('incorreta');
                mostrarMensagem(resultadoQuiz, 'Ops, resposta errada! A opção correta é "Drones Agrícolas". ❌', 'erro');
            }
        });
    });

    // 3. FORMULÁRIO DE CONTATO
    const formContato = document.getElementById('formContato');
    const resultadoForm = document.getElementById('resultadoForm');

    if (formContato) {
        formContato.addEventListener('submit', (evento) => {
            evento.preventDefault(); // Não recarrega a página

            const nome = document.getElementById('nome').value.trim();

            mostrarMensagem(
                resultadoForm, 
                `Obrigado pelo contato, <strong>${nome}</strong>! Sua mensagem foi enviada com sucesso. 🚀`, 
                'sucesso'
            );

            formContato.reset();
        });
    }

    // Função para exibir as mensagens na tela
    function mostrarMensagem(elemento, texto, tipo) {
        if (elemento) {
            elemento.innerHTML = texto;
            elemento.className = `mensagem-resultado ${tipo}`;
        }
    }
});
